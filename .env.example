# Copier ce fichier en ".env" (jamais commité sur GitHub) et remplir les valeurs.

# Fuseau horaire
TZ=Europe/Zurich

# Mot de passe admin Grafana (au premier démarrage uniquement)
GRAFANA_ADMIN_PASSWORD=change-me

# Jeton du tunnel Cloudflare (créé dans le dashboard Cloudflare Zero Trust
# > Networks > Tunnels > Créer un tunnel > Docker > copier le token)
CLOUDFLARE_TUNNEL_TOKEN=

# --- Intégration Tesla (jalon 4) ---

# Client ID de l'app développeur Tesla (developer.tesla.com), partagé entre
# l'intégration "Tesla Fleet" de Home Assistant et TeslaMate.
TESLA_CLIENT_ID=

# Mot de passe de la base Postgres dédiée à TeslaMate.
TESLAMATE_DB_PASSWORD=change-me

# Clé de chiffrement TeslaMate (protège les tokens Tesla stockés en base).
# Générer par ex. avec : openssl rand -base64 32
TESLAMATE_ENCRYPTION_KEY=
