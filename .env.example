# Copier ce fichier en ".env" (jamais commité sur GitHub) et remplir les valeurs.

# Fuseau horaire
TZ=Europe/Zurich

# Mot de passe admin Grafana (au premier démarrage uniquement)
GRAFANA_ADMIN_PASSWORD=change-me

# Jeton du tunnel Cloudflare (créé dans le dashboard Cloudflare Zero Trust
# > Networks > Tunnels > Créer un tunnel > Docker > copier le token)
CLOUDFLARE_TUNNEL_TOKEN=
